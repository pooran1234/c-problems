#include <stdio.h>

int main() {
    int class, age;
    float fare = 0;

    scanf("%d", &class);
    scanf("%d", &age);

    switch(class) {
        case 1:
            fare = 300;
            break;

        case 2:
            fare = 1000;
            break;

        default:
            printf("Invalid class");
            return 0;
    }

    // Discount check
    if(age < 12) {
        fare = fare * 0.5;
    }
    else if(age >= 60 && class == 1) {
        fare = fare * 0.67;   // 33% discount
    }

    printf("Fare ₹%.0f", fare);

    return 0;
}
