#include <stdio.h>

int main()
{
    int n,i=0,x;
    int current=0,longest=0;

    scanf("%d",&n);

    while(i<n)
    {
        scanf("%d",&x);

        if(x==0)
        {
            current++;

            if(current>longest)
            {
                longest=current;
            }
        }
        else
        {
            current=0;
        }

        i++;
    }

    printf("Longest Failure Streak: %d",longest);

    return 0;
}
