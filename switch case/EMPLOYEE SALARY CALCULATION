#include<stdio.h>
int main(){
    int code;
    int experience;
    int salary=0,bonus=0;

    scanf("%d",&code);
    scanf("%d",&experience);
    switch(code){
        case 1:
        salary=50000;
        break;
        case 2:
        salary=35000;
        break;
        default:
        printf("invalid code");
        
    }
    if(experience>=3){
    bonus=experience*5000;}
    printf("%d",salary+bonus);
    return 0;
}
