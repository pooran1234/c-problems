#include <stdio.h>
#include <math.h>

int main()
{
    int n, i = 0, remainder, decimal = 0;

    scanf("%d", &n);

    while(n > 0)
    {
        remainder = n % 10;
        decimal = decimal + remainder * pow(2, i);
        n = n / 10;
        i++;
    }

    printf("%d", decimal);

    return 0;
}
