#include<stdio.h>
int main(){
    char a=5,b=3,op='+';
    switch(op){
        case '+':
        printf("%d",a+b);
        break;
        case '-':
        printf("%d",a-b);
        break;
        case '*':
        printf("%d",a*b);
        break;
        case '/':
        printf("%d",a/b);
    }
return 0;
}
