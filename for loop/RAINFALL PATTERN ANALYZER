#include <stdio.h>

int main()
{
    int n, rain, total = 0, count = 0;

    scanf("%d", &n);

    for(int i = 1; i <= n; i++)
    {
        scanf("%d", &rain);

        total = total + rain;

        if(rain > 50)
        {
            count++;
        }
    }

    printf("Total Rainfall: %d\n", total);
    printf("Heavy Rain Days: %d", count);

    return 0;
}
