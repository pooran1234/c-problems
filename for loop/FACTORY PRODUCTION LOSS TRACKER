#include <stdio.h>

int main()
{
    int n, loss, total = 0, count = 0;

    scanf("%d", &n);

    for(int i = 1; i <= n; i++)
    {
        scanf("%d", &loss);

        total = total + loss;

        if(loss > 100)
        {
            count++;
        }
    }

    printf("Total Loss: %d\n", total);
    printf("High Loss Days: %d", count);

    return 0;
}
