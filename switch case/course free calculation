#include<stdio.h>
int main(){
    int course;
    char category;
    scanf("%d",&course);
    scanf(" %c",&category);
    switch(course){
        case 1:
        if(category=='R'){
            printf("5000");
        }else if(category=='S'){
            printf("3000");
        }
        else{
            printf("invalid category");
        }
        break;
        case 2:
        if(category=='R'){
            printf("9000");
        }
        else if(category=='S'){
            printf("7000");
        }
        else{
            printf("invalid category");

        }
        break;
        default:
        printf("invalid course");

    }
    return 0;
}
